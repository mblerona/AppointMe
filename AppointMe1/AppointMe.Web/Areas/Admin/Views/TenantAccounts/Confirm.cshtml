@model TenantAccountActionVm
@{
    ViewData["Title"] = Model.Heading;
}

<a class="admin-back" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.TenantId"><i class="bi bi-arrow-left"></i> Back to details</a>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">@Model.Heading</h1>
    </div>
</div>

<form method="post" asp-area="Admin" asp-controller="TenantAccounts" asp-action="@Model.Action" asp-route-id="@Model.TenantId" class="admin-card admin-form-card">
    <div class="admin-card-body">
        <dl class="admin-dl mb-4">
            <dt>Business</dt>
            <dd>@Model.BusinessName</dd>
            <dt>Account</dt>
            <dd class="fw-semibold">@(Model.AccountEmail ?? "—")</dd>
        </dl>

        <div class="admin-callout admin-callout-info">
            <i class="bi bi-info-circle"></i>
            <div>@Model.Explanation</div>
        </div>

        <input type="hidden" name="accountId" value="@Model.AccountId" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">@Model.Button</button>
            <a class="btn btn-light" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.TenantId">Cancel</a>
        </div>
    </div>
</form>
