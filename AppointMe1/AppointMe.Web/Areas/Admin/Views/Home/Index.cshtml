@model PlatformTotalsDTO
@{
    ViewData["Title"] = "Platform administration";
}

<h1 class="h3 mb-2">Platform administration</h1>
<p class="text-muted">Manage the businesses that use AppointMe.</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Total tenants</div>
                <div class="h3 mb-0" id="total-tenants">@Model.TotalTenants</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Active</div>
                <div class="h3 mb-0" id="active-tenants">@Model.ActiveTenants</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">Suspended</div>
                <div class="h3 mb-0" id="suspended-tenants">@Model.SuspendedTenants</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted small">New in the last 30 days</div>
                <div class="h3 mb-0" id="new-tenants">@Model.NewTenantsLast30Days</div>
            </div>
        </div>
    </div>
</div>

<a class="btn btn-primary" asp-area="Admin" asp-controller="Tenants" asp-action="Index">
    <i class="bi bi-building me-1"></i> View all tenants
</a>
