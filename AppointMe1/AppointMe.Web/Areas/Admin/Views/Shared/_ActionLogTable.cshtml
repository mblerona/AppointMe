@model IReadOnlyList<AdminActionLogDTO>
<div class="table-responsive">
    <table class="table admin-table align-middle">
        <thead>
            <tr>
                <th>When</th>
                <th>Business</th>
                <th>Action</th>
                <th>Details</th>
                <th>By</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model)
            {
                <tr>
                    <td class="text-nowrap text-muted small">@entry.At.ToString("d MMM yyyy, HH:mm")</td>
                    <td>
                        @if (entry.BusinessExists)
                        {
                            <a asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@entry.BusinessId">@entry.BusinessName</a>
                        }
                        else
                        {
                            <span class="text-muted">@entry.BusinessName</span>
                        }
                    </td>
                    <td>
                        <span class="fw-semibold">@entry.Action.DisplayText()</span>
                        @if (!string.IsNullOrEmpty(entry.ChangedFields))
                        {
                            <div class="small text-muted">@entry.ChangedFields</div>
                        }
                    </td>
                    <td>
                        @(entry.Reason ?? (string.IsNullOrEmpty(entry.Note) ? "—" : ""))
                        @if (!string.IsNullOrEmpty(entry.Note))
                        {
                            <div class="small text-muted pre-line">@entry.Note</div>
                        }
                    </td>
                    <td class="text-muted small">@(entry.AdminEmail ?? "—")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
