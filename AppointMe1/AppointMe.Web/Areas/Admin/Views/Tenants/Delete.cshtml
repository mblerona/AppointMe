@model TenantDeleteVm
@{
    ViewData["Title"] = "Delete business";
}

<a class="admin-back" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i> Back to details</a>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Permanently delete @Model.Tenant.Name?</h1>
    </div>
</div>

<div class="admin-form-card">
    <div class="admin-callout admin-callout-danger" role="alert">
        <i class="bi bi-exclamation-octagon"></i>
        <div>
            <strong>This can't be undone.</strong> It removes all customers (@Model.Tenant.CustomerCount),
            appointments (@Model.Tenant.AppointmentCount) and invoices (@Model.Tenant.InvoiceCount),
            all services and categories, the logo and the users of this business. The tenant gets a final email.
        </div>
    </div>

    @if (Model.IsApproval && !string.IsNullOrEmpty(Model.Tenant.DeletionRequestReason))
    {
        <div class="admin-card mb-3">
            <div class="admin-card-header"><i class="bi bi-chat-left-quote"></i> The tenant's reason</div>
            <div class="admin-card-body pre-line">@Model.Tenant.DeletionRequestReason</div>
        </div>
    }

    <form method="post" asp-area="Admin" asp-controller="Tenants" asp-action="@(Model.IsApproval ? "Approve" : "Delete")" asp-route-id="@Model.Id" class="admin-card">
        <div class="admin-card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            @if (!Model.IsApproval)
            {
                <div class="mb-3">
                    <label asp-for="Reason" class="form-label"></label>
                    <input asp-for="Reason" class="form-control" maxlength="@AdminActionLog.MaxReasonLength" />
                    <span asp-validation-for="Reason" class="text-danger"></span>
                    <div class="form-text">This stays in the action log after the business is gone, so don't include personal details.</div>
                </div>
            }

            <div class="mb-4">
                <label asp-for="ConfirmName" class="form-label">To confirm, type the business name: <strong>@Model.Tenant.Name</strong></label>
                <input asp-for="ConfirmName" class="form-control" autocomplete="off" />
                <span asp-validation-for="ConfirmName" class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Permanently delete this business</button>
                <a class="btn btn-light" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </div>
    </form>
</div>
