@model TenantDetailsDTO
@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-3">
    <a asp-area="Admin" asp-controller="Tenants" asp-action="Index"><i class="bi bi-arrow-left"></i> All tenants</a>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.Name <partial name="_StatusBadge" model="Model.Status" /></h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Tenants" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        @if (Model.Status == BusinessStatus.Suspended)
        {
            <a class="btn btn-outline-success" asp-area="Admin" asp-controller="Tenants" asp-action="Reactivate" asp-route-id="@Model.Id">
                <i class="bi bi-play-circle me-1"></i> Reactivate
            </a>
        }
        else
        {
            <a class="btn btn-outline-danger" asp-area="Admin" asp-controller="Tenants" asp-action="Suspend" asp-route-id="@Model.Id">
                <i class="bi bi-pause-circle me-1"></i> Suspend
            </a>
        }
        <a class="btn btn-danger" asp-area="Admin" asp-controller="Tenants" asp-action="Delete" asp-route-id="@Model.Id">
            <i class="bi bi-trash me-1"></i> Delete
        </a>
    </div>
</div>

@if (Model.DeletionRequestedAt is { } deletionRequestedAt)
{
    <div class="alert alert-warning" id="deletion-request" role="alert">
        <div class="fw-semibold">The tenant asked for this account to be deleted on @deletionRequestedAt.ToString("d MMM yyyy, HH:mm")</div>
        @if (!string.IsNullOrEmpty(Model.DeletionRequestReason))
        {
            <div style="white-space: pre-line;">Reason: @Model.DeletionRequestReason</div>
        }
        <div class="mt-2 d-flex gap-2">
            <a class="btn btn-sm btn-danger" asp-area="Admin" asp-controller="Tenants" asp-action="Approve" asp-route-id="@Model.Id">Approve</a>
            <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-controller="Tenants" asp-action="Dismiss" asp-route-id="@Model.Id">Dismiss</a>
        </div>
    </div>
}

@if (Model.Status == BusinessStatus.Suspended)
{
    <div class="alert alert-danger" role="alert">
        <div class="fw-semibold">
            Suspended
            @if (Model.SuspendedAt is { } suspendedAt)
            {
                <text>on @suspendedAt.ToString("d MMM yyyy, HH:mm")</text>
            }
        </div>
        <div>Reason: @Model.SuspensionReason?.DisplayText()</div>
        @if (!string.IsNullOrEmpty(Model.SuspensionNote))
        {
            <div style="white-space: pre-line;">Note: @Model.SuspensionNote</div>
        }
    </div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Account</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Owner email</dt>
                    <dd class="col-sm-8">@(Model.OwnerEmail ?? "—")</dd>
                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("d MMM yyyy, HH:mm") <span class="text-muted small">Europe/Skopje</span></dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Business contact details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "—")</dd>
                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone.ToDisplayPhone())</dd>
                    <dt class="col-sm-4">Address</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-header">Usage</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-2">Customers</dt>
                    <dd class="col-sm-2" id="customer-count">@Model.CustomerCount</dd>
                    <dt class="col-sm-2">Appointments</dt>
                    <dd class="col-sm-2" id="appointment-count">@Model.AppointmentCount</dd>
                    <dt class="col-sm-2">Invoices</dt>
                    <dd class="col-sm-2" id="invoice-count">@Model.InvoiceCount</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-header">Action log</div>
            @if (Model.ActionLog.Count == 0)
            {
                <div class="card-body text-muted">No admin actions yet.</div>
            }
            else
            {
                <partial name="_ActionLogTable" model="Model.ActionLog" />
            }
        </div>
    </div>
</div>
