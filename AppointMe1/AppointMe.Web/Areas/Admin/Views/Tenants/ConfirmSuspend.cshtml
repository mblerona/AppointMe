@model TenantSuspendVm
@{
    ViewData["Title"] = "Confirm suspension";
}

<a class="admin-back" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i> Back to details</a>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Suspend @Model.BusinessName?</h1>
        <p class="admin-page-subtitle">Step 2 of 2: check the details and confirm.</p>
    </div>
</div>

<div class="admin-card admin-form-card">
    <div class="admin-card-body">
        <div class="admin-callout admin-callout-danger">
            <i class="bi bi-slash-circle"></i>
            <div>
                Everyone at this business is locked out on their next request and sees the reason below.
                They also get an email.
            </div>
        </div>

        <dl class="admin-dl mb-4">
            <dt>Reason</dt>
            <dd>@Model.Reason!.Value.DisplayText()</dd>
            <dt>Note</dt>
            <dd class="pre-line">@(string.IsNullOrWhiteSpace(Model.Note) ? "—" : Model.Note.Trim())</dd>
        </dl>

        <form method="post" asp-area="Admin" asp-controller="Tenants" asp-action="ConfirmSuspend" asp-route-id="@Model.Id" class="d-flex gap-2">
            <input type="hidden" asp-for="Reason" />
            <input type="hidden" asp-for="Note" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-pause-circle me-1"></i> Suspend this business</button>
            <a class="btn btn-light" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        </form>
    </div>
</div>
