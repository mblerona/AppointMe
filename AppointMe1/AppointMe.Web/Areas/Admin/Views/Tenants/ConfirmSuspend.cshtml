@model TenantSuspendVm
@{
    ViewData["Title"] = "Confirm suspension";
}

<h1 class="h3 mb-3">Suspend @Model.BusinessName?</h1>

<div class="card mb-3">
    <div class="card-body">
        <p>
            Everyone at this business is locked out on their next request and sees the reason below.
            They also get an email.
        </p>
        <dl class="row mb-0">
            <dt class="col-sm-2">Reason</dt>
            <dd class="col-sm-10">@Model.Reason!.Value.DisplayText()</dd>
            <dt class="col-sm-2">Note</dt>
            <dd class="col-sm-10" style="white-space: pre-line;">@(string.IsNullOrWhiteSpace(Model.Note) ? "—" : Model.Note.Trim())</dd>
        </dl>
    </div>
</div>

<form method="post" asp-area="Admin" asp-controller="Tenants" asp-action="ConfirmSuspend" asp-route-id="@Model.Id" class="d-flex gap-2">
    <input type="hidden" asp-for="Reason" />
    <input type="hidden" asp-for="Note" />
    <button type="submit" class="btn btn-danger">Suspend this business</button>
    <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>
