@model TenantDismissVm
@{
    ViewData["Title"] = "Dismiss deletion request";
}

<h1 class="h3 mb-3">Dismiss the deletion request from @Model.BusinessName?</h1>

<form method="post" asp-area="Admin" asp-controller="Tenants" asp-action="Dismiss" asp-route-id="@Model.Id" class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        <p>The account stays as it is, and the tenant gets an email saying the request was not approved.</p>

        <div class="mb-3">
            <label asp-for="Note" class="form-label">Note (optional)</label>
            <textarea asp-for="Note" class="form-control" rows="3" maxlength="@AdminActionLog.MaxNoteLength"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
            <div class="form-text">Only for the action log; the tenant doesn't see it.</div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Dismiss the request</button>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </div>
</form>
