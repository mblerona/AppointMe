@model TenantSuspendVm
@{
    ViewData["Title"] = "Suspend business";
}

<a class="admin-back" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-arrow-left"></i> Back to details</a>

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Suspend @Model.BusinessName</h1>
        <p class="admin-page-subtitle">Step 1 of 2: choose why. You confirm on the next page.</p>
    </div>
</div>

<form method="post" asp-area="Admin" asp-controller="Tenants" asp-action="Suspend" asp-route-id="@Model.Id" class="admin-card admin-form-card">
    <div class="admin-card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Reason" class="form-label"></label>
            <select asp-for="Reason" class="form-select">
                <option value="">Choose a reason</option>
                @foreach (var reason in SuspensionReasons.All)
                {
                    <option value="@reason">@reason.DisplayText()</option>
                }
            </select>
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Note" class="form-label">Note</label>
            <textarea asp-for="Note" class="form-control" rows="3" maxlength="@AdminActionLog.MaxNoteLength"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
            <div class="form-text">Required for "Other", optional for the rest.</div>
        </div>

        <div class="admin-callout admin-callout-warning mb-4" role="alert">
            <i class="bi bi-eye"></i>
            <div><strong>The tenant will see this note</strong>, on their suspended page and in the email.</div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Continue <i class="bi bi-arrow-right ms-1"></i></button>
            <a class="btn btn-light" asp-area="Admin" asp-controller="Tenants" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        </div>
    </div>
</form>
