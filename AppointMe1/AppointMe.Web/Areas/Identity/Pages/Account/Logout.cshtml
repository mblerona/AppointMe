@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
    Layout = "../_AuthLayout.cshtml";
}

@if (User.Identity?.IsAuthenticated == true)
{
    @* Opening this address doesn't log anyone out; only the POST below does. *@
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Log out</h1>
        <div class="text-muted">Do you want to log out of AppointMe?</div>
    </div>

    <form asp-page="./Logout" method="post">
        <button type="submit" class="btn btn-primary"><i class="bi bi-box-arrow-right me-1"></i> Log out</button>
    </form>
}
else
{
    <div class="mb-4">
        <h1 class="fw-bold mb-1">You have logged out</h1>
        <div class="text-muted">You have been logged out of AppointMe successfully.</div>
    </div>

    <a asp-page="./Login" class="btn btn-primary"><i class="bi bi-box-arrow-in-right me-1"></i> Log in</a>
}
