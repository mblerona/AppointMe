@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm email";
    Layout = "../_AuthLayout.cshtml";
}

@if (Model.Succeeded)
{
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Email confirmed</h1>
        <div class="text-muted">Thank you. Your account is now active.</div>
    </div>

    <a asp-page="./Login" class="btn btn-primary"><i class="bi bi-box-arrow-in-right me-1"></i> Log in</a>
}
else
{
    <div class="mb-4">
        <h1 class="fw-bold mb-1">Confirmation failed</h1>
        <div class="text-muted">This confirmation link is invalid or has expired.</div>
    </div>

    <div class="d-flex flex-wrap gap-3 small-link">
        <a asp-page="./ResendEmailConfirmation" class="fw-semibold">Resend confirmation email</a>
        <a asp-page="./Login">Go to log in</a>
    </div>
}
