@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend confirmation email";
    Layout = "../_AuthLayout.cshtml";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Resend confirmation email</h1>
    <div class="text-muted">Enter the email you registered with and we'll send a new confirmation link.</div>
</div>

@if (Model.Submitted)
{
    <div class="alert alert-info" role="status">
        <i class="bi bi-envelope-check me-1"></i> @ResendEmailConfirmationModel.SentMessage
    </div>
}

<form method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label fw-semibold">Email</label>
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        </div>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i> Resend</button>

    <div class="mt-3 small-link">
        <a asp-page="./Login">Back to log in</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
