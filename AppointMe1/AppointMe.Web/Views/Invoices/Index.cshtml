@model IEnumerable<AppointMe.Domain.DTO.InvoiceDTO>

@{
    ViewData["Title"] = "Invoices";

    // Newest first; the number breaks ties within the same moment.
    var invoices = (Model ?? Enumerable.Empty<AppointMe.Domain.DTO.InvoiceDTO>())
        .OrderByDescending(i => i.IssuedAt)
        .ThenByDescending(i => i.InvoiceNumber)
        .ToList();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .page-wrap {
        max-width: 980px;
        margin: 0 auto;
    }

    .card-soft {
        border: 1px solid rgba(0,0,0,.06);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        background: #fff;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .amount {
        font-variant-numeric: tabular-nums;
    }
</style>

<div class="page-wrap py-4">

    <div class="mb-3">
        <h2 class="fw-bold mb-0">Invoices</h2>
        <div class="text-muted small mt-1">
            Invoices are created from an appointment's Details page.
        </div>
    </div>

    <div class="card card-soft">
        <div class="card-body p-3 p-md-4">
            @if (invoices.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Number</th>
                                <th>Customer</th>
                                <th>Issued</th>
                                <th>Appointment</th>
                                <th class="text-end">Total</th>
                                <th>Status</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in invoices)
                            {
                                <tr>
                                    <td class="fw-semibold">@i.InvoiceNumber</td>
                                    <td>@i.CustomerName</td>
                                    <td>@i.IssuedAt.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @i.AppointmentDate.ToString("dd MMM yyyy HH:mm")
                                        @if (!string.IsNullOrWhiteSpace(i.OrderNumber))
                                        {
                                            <div class="text-muted small">@i.OrderNumber</div>
                                        }
                                    </td>
                                    <td class="amount fw-semibold text-end">@i.Total.ToString("0.00") ден</td>
                                    <td><span class="badge rounded-pill text-bg-light border">@i.Status</span></td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@i.Id">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-1"></i>No invoices yet. Open an appointment with services and choose <b>Invoice</b>.
                </div>
            }
        </div>
    </div>

</div>
