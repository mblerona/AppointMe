@model AppointMe.Web.ViewModels.SuspendedVm
@{
    ViewData["Title"] = "Account suspended";
    ViewData["AuthHeading"] = "We're here to help";
    ViewData["AuthText"] = "If you think this is a mistake or want to resolve it, please contact support.";
    Layout = "/Areas/Identity/Pages/_AuthLayout.cshtml";
}

<div class="mb-4">
    <h1 class="fw-bold mb-1">Your account has been suspended</h1>
    <div class="text-muted">@Model.Suspension.BusinessName can't use AppointMe at the moment.</div>
</div>

<dl class="mb-4">
    <dt>Reason</dt>
    <dd>@Model.Suspension.Reason</dd>

    @if (!string.IsNullOrEmpty(Model.Suspension.Note))
    {
        <dt>Note</dt>
        <dd style="white-space: pre-line;">@Model.Suspension.Note</dd>
    }

    @if (Model.Suspension.SuspendedAt is { } suspendedAt)
    {
        <dt>Suspended on</dt>
        <dd>@suspendedAt.ToString("d MMM yyyy")</dd>
    }
</dl>

@if (string.IsNullOrEmpty(Model.SupportEmail))
{
    <p>Please contact support for help with your account.</p>
}
else
{
    <p>For help with your account, contact <a href="mailto:@Model.SupportEmail" class="fw-semibold">@Model.SupportEmail</a>.</p>
}

<form asp-area="Identity" asp-page="/Account/Logout" method="post" class="mt-4">
    <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-right me-1"></i> Log out</button>
</form>
