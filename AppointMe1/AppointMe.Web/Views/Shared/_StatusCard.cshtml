@model AppointMe.Web.ViewModels.StatusPageVm
@* The friendly card for status pages (404, 403, 429, ...) and the Access denied page. Fixed text only. *@

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha384-XGjxtQfXaH2tnPFa9x+ruJTuLE3Aa6LhHSWRr1XeTyhezb4abCG4ccI5AkVDxqC+" crossorigin="anonymous">

<style>
    .status-wrap {
        max-width: 560px;
        margin: 48px auto;
    }

    .status-card {
        border: 1px solid rgba(0,0,0,.06);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.06);
        background: #fff;
    }

    .status-icon {
        font-size: 2.5rem;
        color: #6c757d;
    }
</style>

<div class="status-wrap">
    <div class="status-card p-4 p-md-5 text-center">
        <i class="bi @Model.Icon status-icon" aria-hidden="true"></i>
        <h1 class="h3 fw-bold mt-3 mb-2">@Model.Title</h1>
        <p class="text-muted mb-4">@Model.Message</p>
        <a class="btn btn-primary" href="/">
            <i class="bi bi-house me-1"></i> Go to the start page
        </a>
    </div>
</div>
